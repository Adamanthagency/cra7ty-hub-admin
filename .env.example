# ── Visual editor bridge ─────────────────────────────────────────────
# Admin (this repo): exact origin (scheme + host + port, no path) of the
# storefront that /admin/pages/[page]/visual frames. Every inbound
# postMessage must come from exactly this origin or it is ignored, and
# every outbound message is posted with it as targetOrigin (never '*').
# Leave unset to disable the bridge entirely (the frame shows an error).
NEXT_PUBLIC_STOREFRONT_ORIGIN=http://localhost:3000

# ── Supabase backend (Stage 4) ───────────────────────────────────
# Read by src/lib/server/content-store.ts — EXACT names, character for
# character. With either URL name missing or the key missing, every
# /admin/api/* route answers 503 naming the variable, and
# /admin/api/diagnostics reports the booleans.
# Public (Vercel: Project → Settings → Environment Variables, Production):
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Server-only — never NEXT_PUBLIC_, never committed, never client code:
SUPABASE_SERVICE_ROLE_KEY=

# Storefront (set in the cra7ty-hub repo; listed here for reference):
# exact origin of THIS admin, which the storefront's edit bridge
# allowlists the same way before accepting admin messages.
NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:3001

# ── Instant publish (on-demand revalidation) ───────────────────
# Both server-only — read by src/lib/server/revalidate.ts; never
# NEXT_PUBLIC_, never client code, never logged.
# STOREFRONT_URL: exact origin of the deployed storefront (no path).
# REVALIDATE_SECRET: the same token the storefront's POST /api/revalidate
# verifies; generate with `openssl rand -hex 32` and set the identical
# value in the storefront's env. Every write route calls the storefront
# after a successful save and reports the result as `revalidate`.
STOREFRONT_URL=http://localhost:3000
REVALIDATE_SECRET=
